<script>
(() => {
  const tg = window.Telegram && window.Telegram.WebApp;
  if (tg) { tg.ready(); tg.expand(); }
  const cards = [...document.querySelectorAll('.item')];
  const summary = document.getElementById('summaryRows');
  const getData = () => cards.map(card => ({
    name: card.dataset.name,
    value: Number(card.querySelector('input').value)
  }));
  const render = () => {
    summary.innerHTML = '';
    cards.forEach(card => {
      const input = card.querySelector('input');
      card.querySelector('output').textContent = input.value + '/10';
      const row = document.createElement('div');
      row.className = 'statline';
      const name = document.createElement('span'); name.textContent = card.dataset.name;
      const value = document.createElement('strong'); value.textContent = input.value + '/10';
      row.append(name, value); summary.append(row);
    });
  };
  const report = () => {
    const lines = getData().map(x => `${x.name}: ${x.value}/10`);
    return `CONTROL & JUDGMENT — DAILY ASSESSMENT\n${new Date().toLocaleString()}\n\n${lines.join('\n')}\n\nObservation: ${document.getElementById('note').value.trim() || '—'}\n\nReflection: These ratings describe today's experience; they are not diagnoses or judgments about me or anyone else.`;
  };
  cards.forEach(card => card.querySelector('input').addEventListener('input', render));
  document.getElementById('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(report()); alert('Assessment copied.'); }
    catch(e) { window.prompt('Copy your assessment:', report()); }
  });
  document.getElementById('send').addEventListener('click', () => {
    if (tg && tg.initData) {
      tg.sendData(JSON.stringify({type:'control_judgment_assessment', text:report(), ratings:getData(), note:document.getElementById('note').value.trim()}));
    } else {
      alert('Open this page inside your Telegram bot to send the assessment to Telegram. You can use Copy assessment here.');
    }
  });
  document.getElementById('reset').addEventListener('click', () => {
    cards.forEach(card => card.querySelector('input').value = 0);
    document.getElementById('note').value = '';
    render();
  });
  document.getElementById('download').addEventListener('click', () => {
    const blob = new Blob([report()], {type:'text/plain;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href=url; a.download='control-judgment-assessment.txt'; a.click();
    URL.revokeObjectURL(url);
  });
  render();
})();
</script>
</body>
